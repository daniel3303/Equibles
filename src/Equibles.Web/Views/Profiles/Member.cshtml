@model Equibles.Web.ViewModels.Profiles.CongressProfileViewModel

@{
    ViewData["Title"] = Model.Name;
}

<div class="max-w-6xl mx-auto px-6 py-12">
    <page-header title="@Model.Name">Member of Congress</page-header>

    <h2 class="text-xl font-semibold mb-3">Recent trades</h2>
    @if (Model.Trades.Count == 0) {
        <div class="text-base-content/60 py-8">No reported trades.</div>
    } else {
        <table-card>
                    <thead>
                        <tr>
                            <th scope="col">Security</th>
                            <th scope="col" class="hidden lg:table-cell">Date</th>
                            <th scope="col" class="hidden lg:table-cell">Owner</th>
                            <th scope="col" class="text-right">Amount (USD)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var trade in Model.Trades) {
                            <tr>
                                <td>
                                    <partial name="_StockLink" model='(Ticker: trade.Ticker, Class: "font-semibold link link-primary")' />
                                    <span class="block max-w-64 truncate text-xs text-base-content/60" title="@trade.AssetName">
                                        @(string.IsNullOrEmpty(trade.AssetType) ? trade.AssetName : $"{trade.AssetType} · {trade.AssetName}")
                                    </span>
                                </td>
                                <td class="hidden lg:table-cell">@trade.TransactionDate.ToString("yyyy-MM-dd")</td>
                                <td class="hidden lg:table-cell">
                                    <span class="block">@(string.IsNullOrEmpty(trade.OwnerType) ? "—" : trade.OwnerType)</span>
                                    @if (!string.IsNullOrEmpty(trade.Subholding)) {
                                        <span class="block max-w-40 truncate text-xs text-base-content/60" title="@trade.Subholding">@trade.Subholding</span>
                                    }
                                </td>
                                <td class="text-right">@trade.AmountFrom.ToString("N0") – @trade.AmountTo.ToString("N0")</td>
                            </tr>
                        }
                    </tbody>
                </table-card>
    }
</div>
