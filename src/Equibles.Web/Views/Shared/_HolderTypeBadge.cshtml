@using Equibles.Holdings.BusinessLogic
@using Equibles.Holdings.Data.Models
@model HolderEntityType?

@* The holder's entity type from regulatory records; Unknown or not yet classified shows no badge. *@
@if (Model is { } type && type != HolderEntityType.Unknown) {
    var css = type switch {
        HolderEntityType.RegisteredAdviser => "badge-primary",
        HolderEntityType.ExemptReportingAdviser => "badge-secondary",
        HolderEntityType.InvestmentAdviser => "badge-primary badge-outline",
        HolderEntityType.Bank => "badge-info",
        HolderEntityType.InsuranceCompany => "badge-warning",
        HolderEntityType.BrokerDealer => "badge-neutral",
        HolderEntityType.RegisteredFund => "badge-success",
        HolderEntityType.BenefitPlan => "badge-accent",
        HolderEntityType.HoldingCompany => "badge-neutral badge-outline",
        _ => "badge-ghost",
    };
    <span class="badge @css badge-sm" data-testid="holder-type" title="From regulatory records, not the name">@HolderBucketTokens.Label(type)</span>
}
